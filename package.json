{
  "name": "amrdiy",
  "version": "1.0.0",
  "private": true,
  "description": "AMR DIY e-commerce monorepo",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "test:frontend": "npm --prefix frontend test -- --passWithNoTests",
    "check:backend": "npm --prefix backend run check",
    "build": "npm --prefix frontend run build",
    "ci": "npm run test:frontend && npm run check:backend && npm run build"
  }
}
